<?xml version="1.0" encoding="utf-8"?>
<!--
  023 Bank SMS Import (FR-055, SC-003): Auto Backup rules for Android 11
  and lower. Exclude-only, so everything else backs up as before. Keeps the
  SMS import key namespace device-local; see data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="daftary_sms_import.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage:daftary_sms_import.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:daftary_sms_import.xml" />
</full-backup-content>
