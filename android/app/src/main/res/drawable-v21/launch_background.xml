<?xml version="1.0" encoding="utf-8"?>
<!-- 019: native launch screen (Android 7-11). The brand field plus the
     coin-less notebook at its intrinsic 288dp, centered on the full window,
     so it matches the first Flutter splash frame exactly. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_field" />

    <!-- splash_mark is generated by build_icon.py in splash mode (assets/icon) -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
